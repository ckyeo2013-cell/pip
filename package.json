{
  "name": "pip-desktop",
  "version": "1.23.0",
  "description": "Pip the sugar glider: a friendly 3D desktop pet that chats, helps you decide and does things on your computer (asks first)",
  "main": "main.js",
  "author": "You <you@example.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node selftest.js && node selftest-brain.js && node selftest-main.js && node selftest-flight.js"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.pip",
    "productName": "Pip",
    "files": [
      "main.js",
      "actions.js",
      "system.js",
      "ui.js",
      "agent.js",
      "brain.js",
      "chess.js",
      "chess-thread.js",
      "games.js",
      "calendar.js",
      "voice.js",
      "voice-client.js",
      "store.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "model.js",
      "icon.png",
      "tray.png",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pip listens only when you tap the microphone button, so you can talk to it."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-GITHUB-NAME/pip-desktop.git"
  }
}